# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google AdMob (rewarded ads — watch-an-ad-to-earn-points on the Earn tab)
# Not secret (ad unit/app IDs are public in the compiled app either way).
# Unset in dev: hooks/useRewardedAd.ts falls back to Google's public TestIds
# so the feature is safe to exercise before real IDs are configured.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_UNIT_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_UNIT_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=

# Google OAuth (native Google Sign-In via @react-native-google-signin/google-signin
# + Supabase signInWithIdToken — see lib/google-auth-service.ts). Requires a custom
# EAS dev client build; does not work in plain Expo Go.
# Web client ID/secret also go into Supabase Dashboard > Authentication > Providers > Google.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# Reversed iOS client ID (e.g. com.googleusercontent.apps.XXXXX-yyyy) — required by
# app.json's google-signin config plugin for the iOS redirect to complete.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-client-id

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-only — read by backend/trpc admin routes, never bundled into the app)
# Get this from Supabase Dashboard > Settings > API > service_role key. It bypasses RLS — keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack Payment (PAYSTACK_SECRET_KEY is server-only — read by backend/trpc, never bundled into the app)
# Test keys start with sk_test_/pk_test_, live keys with sk_live_/pk_live_ — never mix
# environments (checkPaymentEnvironmentConsistency in backend/lib/payment-env-check.ts
# warns at server startup if a test key is used with NODE_ENV=production).
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# Paystack signs webhooks with PAYSTACK_SECRET_KEY itself (HMAC-SHA512 over the raw
# body, x-paystack-signature header) — no separate webhook secret needed. Register
# https://<your-api-host>/api/webhooks/paystack in the Paystack dashboard (test and
# live dashboards each need their own registration, pointing at the matching backend).

# Flutterwave Payment (FLUTTERWAVE_SECRET_KEY is server-only — read by backend/trpc, never bundled into the app)
# Test keys start with FLWSECK_TEST/FLWPUBK_TEST, live keys with FLWSECK-/FLWPUBK- — never mix.
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxx
# Flutterwave webhook auth (server-only — read by backend/lib/webhook-signatures.ts, never
# bundled into the app). NOT derived from the secret key — this is a separate static value
# YOU choose and set in the Flutterwave dashboard's webhook settings; they echo it back
# verbatim in every webhook's verif-hash header, and this is compared against it. Register
# https://<your-api-host>/api/webhooks/flutterwave in the dashboard alongside this value.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Bank account encryption (server-only — read by backend/lib/bank-account-crypto.ts, never bundled into the app)
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Rotating this key
# without first re-encrypting existing rows makes them permanently undecryptable —
# see scripts/backfill-bank-account-encryption.ts before ever changing it in production.
BANK_ACCOUNT_ENCRYPTION_KEY=

# App
# Local dev default — Expo dev server serves the API directly (see app/api/[...path]+api.ts).
# Only matters for real production builds; local dev auto-detects the correct URL.
EXPO_PUBLIC_RORK_API_BASE_URL=https://your-app.rork.app

# Driver verification (all server-only — read by backend/services/verification/, never bundled into the app)
# Unset by default: document-consistency and authenticity checks safely fall back to
# manual review rather than fabricating a pass (see backend/services/verification/
# ocr-provider.ts and authenticity-provider.ts). Setting these to an unrecognized
# value has the same safe effect — no vendor is implemented in this codebase yet.
OCR_PROVIDER=
OCR_PROVIDER_API_KEY=
AUTHENTICITY_PROVIDER=
AUTHENTICITY_PROVIDER_API_KEY=
# Keep false unless a real, authorized authenticity provider is configured above —
# with no provider configured this has no effect (every driver still requires an
# explicit admin.driverVerification.decide call to reach VERIFIED).
AUTO_APPROVE_ON_PROVIDER_VERIFIED=false
