{
  "expo": {
    "name": "Pantra",
    "slug": "pantra-ride-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pantra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0e59731b-2f15-4f3c-a3fa-78a6021da0e7"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pantra.rides",
      "config": {
        "googleMapsApiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
      },
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Pantra needs your location to find nearby drivers and show your trip on the map.",
        "NSLocationAlwaysUsageDescription": "Pantra needs your location in the background to track your trip.",
        "NSLocationWhenInUseUsageDescription": "Pantra needs your location to find nearby drivers and show your trip on the map.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "NSMicrophoneUsageDescription": "Pantra uses the microphone for voice features.",
        "NSPhotoLibraryUsageDescription": "Pantra accesses your photos to let you upload your profile picture and driver documents.",
        "NSCameraUsageDescription": "Pantra uses the camera to let you capture and upload driver documents."
      }
    },
    "android": {
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pantra.rides",
      "config": {
        "googleMaps": {
          "apiKey": "${EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Pantra needs your location to find nearby drivers and show your trip on the map."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0F172A",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pantra accesses your photos to let you upload your profile picture and driver documents.",
          "cameraPermission": "Pantra uses the camera to capture driver documents."
        }
      ],
      "expo-video",
      "expo-font",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "${EXPO_PUBLIC_ADMOB_ANDROID_APP_ID}",
          "iosAppId": "${EXPO_PUBLIC_ADMOB_IOS_APP_ID}"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e59731b-2f15-4f3c-a3fa-78a6021da0e7"
      }
    },
    "owner": "shenum"
  }
}
